      <div class="profile" style="margin: 16px 0;">
        <img id="idPhoto" class="avatar" alt="ID photo" src="https://placehold.co/200x200/202944/ffffff?text=Photo">
        <div>
          <h2 id="idName">Saijeevana</h2>
          <p><b>Roll No:</b> <span id="idRoll">107</span></p>
          <p><b>Branch:</b> CSE</p>
        </div>

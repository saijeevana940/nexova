  <!-- Results Section -->
  <section id="results" class="section">
    <h1>Semester Results & Simulator</h1>
    <div class="panel">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Subject</th><th>Type</th><th>Internal</th><th>External</th><th>Total</th><th>Grade</th></tr></thead>
          <tbody id="resultRows"></tbody>
        </table>
      </div>

      <div class="simulator-card">
        <h3 style="color:var(--mint);">🔮 Interactive What-If GPA Simulator</h3>
        <div class="sim-grid">
          <div>
            <div class="sim-slider-row">
              <label>External Score Avg: <span id="simExtLbl">60 / 70</span></label>
              <input type="range" id="simExtInput" min="30" max="70" value="60" oninput="runGpaSim()">
            </div>
          </div>
          <div class="sim-kpi-result">
            <p style="font-size:11px; text-transform:uppercase; color:var(--text-muted);">Projected SGPA</p>
            <div style="font-size:38px; font-weight:800; color:var(--mint);" id="simGpaVal">8.12</div>
          </div>
        </div>
      </div>
    </div>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXORA | AI-Powered Student Academic & Success Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #090d1b;
  --panel: #11182b;
  --panel-hover: #162038;
  --line: #27324d;
  --line-bright: #39486d;
  --text: #f4f7ff;
  --text-muted: #9ca9c6;
  --text-sub: #cbd5e1;

  --mint: #55e6c1;
  --mint-glow: rgba(85, 230, 193, 0.22);
  --purple: #9b7bff;
  --purple-glow: rgba(155, 123, 255, 0.25);
  --blue: #69a7ff;
  --blue-glow: rgba(105, 167, 255, 0.22);
  --cyan: #06b6d4;
  --cyan-glow: rgba(6, 182, 212, 0.22);
  --amber: #f59e0b;
  --amber-glow: rgba(245, 158, 11, 0.2);
  --red: #ef4444;
  --red-glow: rgba(239, 68, 68, 0.2);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

* { 
  box-sizing: border-box; 
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Plus Jakarta Sans', Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
  min-height: 100vh;
  background-image: 
    radial-gradient(circle at 10% 10%, rgba(85, 230, 193, 0.05) 0%, transparent 40%),
    radial-gradient(circle at 90% 70%, rgba(155, 123, 255, 0.05) 0%, transparent 45%);
  background-attachment: fixed;
}

/* Custom Scrollbar */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--line); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--line-bright); }

/* Header */
header {
  padding: 14px 24px;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(12px);
}

.brand-wrapper {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-icon {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--mint), var(--purple));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 800;
  color: #090d1b;
  box-shadow: 0 0 16px var(--mint-glow);
}

.logo-text { 
  color: var(--mint); 
  font-size: 22px; 
  font-weight: 800; 
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo-ai-badge {
  font-size: 10px;
  background: linear-gradient(90deg, var(--purple), var(--mint));
  color: #090d1b;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 6px;
  letter-spacing: 0.5px;
}

.logo-sub { 
  color: var(--text-muted); 
  font-size: 11px; 
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Header Center - Perspective Switcher */
.header-center {
  display: flex;
  align-items: center;
  gap: 10px;
}

.role-switcher {
  background: #090d1b;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px;
  display: flex;
  gap: 4px;
}

.role-btn {
  border: none;
  background: transparent;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 700;
  padding: 6px 14px;
  border-radius: 999px;
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  gap: 6px;
}

.role-btn.active {
  background: linear-gradient(135deg, var(--mint), #2ecc71);
  color: #090d1b;
  box-shadow: 0 2px 10px var(--mint-glow);
}

/* Header Search */
.header-search {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #090d1b;
  border: 1px solid var(--line);
  padding: 6px 10px 6px 14px;
  border-radius: var(--radius-md);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.header-search:focus-within {
  border-color: var(--mint);
  box-shadow: 0 0 0 3px var(--mint-glow);
}

.header-search input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 14px;
  width: 170px;
}

.header-search button {
  background: var(--mint);
  color: #07151b;
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s;
}

.header-search button:hover {
  opacity: 0.9;
}

.header-actions-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.audio-btn {
  background: #090d1b;
  border: 1px solid var(--line);
  color: var(--text-muted);
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 16px;
  transition: var(--transition);
}

.audio-btn:hover {
  color: var(--text);
  border-color: var(--mint);
}

.college-tag {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 600;
  border-left: 1px solid var(--line);
  padding-left: 16px;
}

/* Layout */
.layout {
  display: grid;
  grid-template-columns: 255px 1fr;
  min-height: calc(100vh - 73px);
}

/* Sidebar Nav */
nav {
  padding: 20px 14px;
  background: #0c1223;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 4px;
  overflow-y: auto;
}

nav .nav-label {
  font-size: 10px;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 1px;
  padding: 12px 12px 4px;
  font-weight: 800;
}

nav button {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 10px 14px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-muted);
  background: transparent;
  text-align: left;
  cursor: pointer;
  font-size: 13.5px;
  font-weight: 600;
  transition: all 0.2s ease;
  position: relative;
}

nav button:hover {
  color: var(--text);
  background: #162038;
}

nav button.active {
  background: #1c2744;
  color: var(--mint);
  border-color: var(--purple);
  box-shadow: 0 4px 14px var(--purple-glow);
}

nav button .nav-pill {
  margin-left: auto;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 6px;
  border-radius: 999px;
  background: rgba(155, 123, 255, 0.2);
  color: var(--purple);
  border: 1px solid rgba(155, 123, 255, 0.3);
}

nav button .nav-pill.ai {
  background: rgba(85, 230, 193, 0.18);
  color: var(--mint);
  border-color: rgba(85, 230, 193, 0.35);
}

/* Main Area */
main { 
  padding: 28px; 
  min-width: 0; 
  max-width: 1200px;
}

.section { display: none; }
.section.active { 
  display: block; 
  animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

h1 { 
  font-size: 26px; 
  font-weight: 800; 
  margin-bottom: 6px;
  letter-spacing: -0.5px;
}

h2 { 
  font-size: 19px; 
  font-weight: 700;
  margin-bottom: 12px;
}

p { line-height: 1.6; }
.muted { color: var(--text-muted); font-size: 14px; }

/* Stat Cards */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 16px;
  margin: 20px 0 24px;
}

.card, .panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  transition: border-color 0.2s ease;
}

.card:hover, .panel:hover {
  border-color: #3b4b74;
}

.stat { 
  font-size: 32px; 
  color: var(--mint); 
  font-weight: 800; 
  margin: 8px 0;
  letter-spacing: -1px;
}

.stat.purple { color: var(--purple); }
.stat.blue { color: var(--blue); }

.card-label {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Progress bar */
.progress {
  height: 9px;
  border-radius: 999px;
  background: #27324d;
  overflow: hidden;
  margin-top: 10px;
}

.progress div {
  height: 100%;
  background: linear-gradient(90deg, var(--mint), #38ef7d);
  border-radius: 999px;
  transition: width 0.4s ease;
}

.progress.warning div {
  background: linear-gradient(90deg, var(--amber), #f87171);
}

/* Buttons and Inputs */
button, input, select { font: inherit; }

.action {
  background: var(--mint);
  color: #07151b;
  padding: 10px 18px;
  border: 0;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: 700;
  font-size: 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.action:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 14px var(--mint-glow);
}

.action-secondary {
  background: #202944;
  color: var(--text);
  border: 1px solid var(--line);
}

.action-secondary:hover {
  background: #283556;
  border-color: var(--purple);
}

input, select {
  background: #090d1b;
  color: white;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  max-width: 100%;
  outline: none;
}

input:focus, select:focus {
  border-color: var(--mint);
  box-shadow: 0 0 0 3px var(--mint-glow);
}

/* Profile Section */
.profile {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.avatar {
  width: 110px;
  height: 110px;
  border-radius: var(--radius-md);
  object-fit: cover;
  background: #202944;
  border: 2px solid var(--purple);
  box-shadow: 0 4px 18px var(--purple-glow);
}

/* Tables */
.table-wrap { 
  overflow-x: auto; 
  margin-top: 14px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
  text-align: left;
}

th, td {
  padding: 13px 14px;
  border-bottom: 1px solid var(--line);
}

th { 
  background: #0d1426;
  color: var(--mint); 
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

tr:last-child td { border-bottom: none; }
tr:hover td { background: rgba(255, 255, 255, 0.02); }

.badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 700;
}

.badge.pass {
  color: var(--mint);
  background: #12332a;
  border: 1px solid rgba(85, 230, 193, 0.3);
}

.badge.warning {
  color: #fbbf24;
  background: #362810;
  border: 1px solid rgba(251, 191, 36, 0.3);
}

/* Results Summary KPI Boxes */
.results-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.kpi-box {
  background: #0c1223;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 14px 16px;
}

.kpi-box p {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
}

.kpi-box h3 {
  font-size: 22px;
  font-weight: 800;
  color: var(--text);
  margin-top: 4px;
}

/* College ID Card */
.idcard-wrapper {
  max-width: 460px;
  background: linear-gradient(145deg, #11182b, #0c1224);
  border: 2px solid var(--mint);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: 0 10px 30px rgba(85, 230, 193, 0.15);
  position: relative;
  overflow: hidden;
}

.id-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
  padding-bottom: 12px;
  margin-bottom: 16px;
}

.id-footer {
  border-top: 1px solid var(--line);
  padding-top: 12px;
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: var(--text-muted);
}

/* AI Advanced Features Styles */
.ai-hero-card {
  background: linear-gradient(145deg, #121c35, #0c1426);
  border: 1px solid var(--purple);
  border-radius: var(--radius-lg);
  padding: 22px;
  margin-bottom: 22px;
  display: grid;
  grid-template-columns: 160px 1fr 240px;
  gap: 22px;
  align-items: center;
  box-shadow: 0 8px 24px rgba(155, 123, 255, 0.12);
}

.ai-dial-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
}

.ai-dial-svg {
  width: 120px;
  height: 120px;
  transform: rotate(-90deg);
}

.ai-dial-bg {
  fill: none;
  stroke: #1c2744;
  stroke-width: 10;
}

.ai-dial-bar {
  fill: none;
  stroke: url(#scoreGrad);
  stroke-width: 10;
  stroke-linecap: round;
  stroke-dasharray: 314;
  stroke-dashoffset: 75;
  transition: stroke-dashoffset 0.8s ease;
}

.ai-dial-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.ai-dial-num {
  font-size: 28px;
  font-weight: 800;
  color: var(--mint);
  line-height: 1;
}

.ai-dial-lbl {
  font-size: 9px;
  color: var(--text-muted);
  font-weight: 800;
  text-transform: uppercase;
  margin-top: 2px;
}

.ai-hero-content h3 {
  font-size: 17px;
  font-weight: 800;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.ai-prescriptions {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 10px;
}

.ai-presc-item {
  font-size: 12.5px;
  background: rgba(9, 13, 27, 0.7);
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  border-left: 3px solid var(--mint);
  color: var(--text-sub);
}

.ai-hero-stats {
  background: #090e1b;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ai-hero-row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 4px;
}

.ai-hero-row:last-child { border-bottom: none; padding-bottom: 0; }
.ai-hero-row span:first-child { color: var(--text-muted); }
.ai-hero-row span:last-child { font-weight: 700; color: #fff; }

/* AI Tutor Chat */
.chat-container {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 20px;
  height: 680px;
}

.chat-personas {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.persona-btn {
  background: #0c1223;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  text-align: left;
  cursor: pointer;
  transition: var(--transition);
  color: var(--text);
}

.persona-btn:hover { border-color: var(--purple); }
.persona-btn.active {
  background: rgba(155, 123, 255, 0.15);
  border-color: var(--purple);
  box-shadow: 0 0 12px var(--purple-glow);
}

.persona-btn h4 { font-size: 13px; font-weight: 700; color: var(--mint); }
.persona-btn p { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

.prompt-chips-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 10px;
}

.chip-prompt {
  background: #090e1b;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 7px 10px;
  font-size: 11.5px;
  color: var(--text-muted);
  cursor: pointer;
  text-align: left;
  transition: var(--transition);
}

.chip-prompt:hover {
  color: var(--mint);
  border-color: var(--mint);
}

.chat-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.chat-head {
  padding: 14px 20px;
  background: #0c1223;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chat-messages {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.chat-msg {
  display: flex;
  gap: 10px;
  max-width: 85%;
}

.chat-msg.bot { align-self: flex-start; }
.chat-msg.user { align-self: flex-end; flex-direction: row-reverse; }

.chat-bubble {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  font-size: 13.5px;
  line-height: 1.6;
}

.chat-msg.bot .chat-bubble {
  background: #0c1223;
  border: 1px solid var(--line);
  color: var(--text);
}

.chat-msg.user .chat-bubble {
  background: #1c2744;
  border: 1px solid var(--purple);
  color: #fff;
}

.chat-input-row {
  padding: 14px 20px;
  background: #0c1223;
  border-top: 1px solid var(--line);
  display: flex;
  gap: 10px;
}

.chat-input-row input { flex: 1; }

/* What-If Simulator */
.simulator-card {
  background: #0c1223;
  border: 1px solid var(--purple);
  border-radius: var(--radius-md);
  padding: 20px;
  margin-top: 20px;
}

.sim-grid {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 22px;
  align-items: center;
}

.sim-slider-row {
  margin-bottom: 14px;
}

.sim-slider-row label {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
}

.sim-slider-row span {
  color: var(--mint);
  font-weight: 700;
}

input[type=range] {
  width: 100%;
  height: 6px;
  background: #090d1b;
  border-radius: 999px;
  outline: none;
  -webkit-appearance: none;
}

input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--mint);
  cursor: pointer;
}

.sim-kpi-result {
  background: #11182b;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 18px;
  text-align: center;
}

/* Responsive */
@media(max-width: 860px) {
  .layout { grid-template-columns: 1fr; }
  nav {
    flex-direction: row;
    overflow-x: auto;
    padding: 10px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  nav .nav-label { display: none; }
  nav button { min-width: max-content; width: auto; padding: 8px 12px; font-size: 13px; }
  main { padding: 18px; }
  header { padding: 12px 16px; }
  .college-tag { display: none; }
  .ai-hero-card { grid-template-columns: 1fr; }
  .chat-container { grid-template-columns: 1fr; height: auto; }
  .sim-grid { grid-template-columns: 1fr; }
}
</style>
</head>

<body>

<!-- Header -->
<header>
  <div class="brand-wrapper">
    <div class="logo-icon">✦</div>
    <div>
      <div class="logo-text">NEXORA <span class="logo-ai-badge">AI 4.0</span></div>
      <div class="logo-sub">Intelligent Academic Platform</div>
    </div>
  </div>

  <div class="header-center">
    <div class="role-switcher">
      <button class="role-btn active" id="roleBtnStudent" onclick="switchRole('student')">🎓 Student Hub</button>
      <button class="role-btn" id="roleBtnFaculty" onclick="switchRole('faculty')">👨‍🏫 Faculty Portal</button>
    </div>
  </div>

  <div class="header-actions-right">

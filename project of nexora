<script>
const students = {
  "107": {
    name: "Saijeevana",
    rollNo: "107",
    department: "Computer Science and Engineering (CSE)",
    branchCode: "CSE",
    year: "Second Year",
    semester: 2,
    college: "St. Marys Group of Institutions",
    healthScore: 76,
    predictedGpa: "7.85 / 10.0",
    detentionRisk: "Moderate (Attendance)",
    aiMessage: "Your test scores are solid (74.5%), but your 67% attendance requires attention.",
    prescriptions: ["Attend the next 4 Database lectures.", "Revise B+ Trees for upcoming midterms."],
    attendance: {
      overall: 67,
      subjects: [
        { name: "Mathematics", attended: 20, total: 30 },
        { name: "Data Structures", attended: 22, total: 30 },
        { name: "Database Systems", attended: 18, total: 30 },
        { name: "Operating Systems", attended: 20, total: 30 }
      ]
    },
    results: {
      2: [
        { name: "Mathematics-II", type: "Theory", internal: 25, external: 59 },
        { name: "Data Structures", type: "Theory", internal: 26, external: 61 },
        { name: "Database Systems", type: "Theory", internal: 24, external: 57 },
        { name: "Operating Systems", type: "Theory", internal: 25, external: 60 }
      ]
    },
    timetable: [
      { time: "09:00–10:00", subject: "Mathematics", room: "Room 101", type: "Lecture" },
      { time: "10:00–11:00", subject: "Data Structures", room: "Room 204", type: "Lecture" }
    ]
  }
};

function getStudentByRoll(roll) {
  return students[String(roll).trim()] || students["107"];
}

let currentRoll = "107";

function showSection(id, button) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (button) {
    document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
    button.classList.add('active');
  }
}

function switchRole(role) {
  if (role === 'faculty') showSection('faculty');
  else showSection('dashboard');
}

function loadStudentByRoll(roll) {
  const student = getStudentByRoll(roll);
  currentRoll = student.rollNo;
  document.getElementById("contextStudentName").textContent = student.name;
  document.getElementById("contextStudentRoll").textContent = student.rollNo;
  document.getElementById("welcomeText").textContent = `Welcome, ${student.name}! 👋`;
  document.getElementById("dashRollNo").textContent = student.rollNo;
  document.getElementById("dashScoreNum").textContent = student.healthScore + "%";
  document.getElementById("dashScoreRing").style.strokeDashoffset = 314 - (314 * (student.healthScore / 100));
  document.getElementById("dashAiMessage").innerHTML = student.aiMessage;
  document.getElementById("dashPredGpa").textContent = student.predictedGpa;
  document.getElementById("dashDetentionRisk").textContent = student.detentionRisk;
  document.getElementById("dashAttendanceStat").textContent = student.attendance.overall + "%";
  document.getElementById("dashAvgMarks").textContent = "74.5%";

  const prescWrap = document.getElementById("dashAiPrescriptions");
  prescWrap.innerHTML = "";
  student.prescriptions.forEach(p => { prescWrap.innerHTML += `<div class="ai-presc-item">✦ ${p}</div>`; });

  // Attendance rows
  const attTbody = document.getElementById("attendanceRows");
  attTbody.innerHTML = "";
  student.attendance.subjects.forEach(sub => {
    const pct = Math.round((sub.attended / sub.total) * 100);
    attTbody.innerHTML += `<tr><td><b>${sub.name}</b></td><td>${sub.attended}</td><td>${sub.total}</td><td>${pct}%</td><td><span class="badge ${pct>=75?'pass':'warning'}">${pct>=75?'Eligible':'Shortage'}</span></td></tr>`;
  });

  // Results rows
  const resTbody = document.getElementById("resultRows");
  resTbody.innerHTML = "";
  student.results[2].forEach(sub => {
    const total = sub.internal + sub.external;
    resTbody.innerHTML += `<tr><td><b>${sub.name}</b></td><td>${sub.type}</td><td>${sub.internal}/30</td><td>${sub.external}/70</td><td><b>${total}</b>/100</td><td><span style="color:var(--mint); font-weight:700;">A</span></td></tr>`;
  });

  // Timetable rows
  const timeTbody = document.getElementById("timetableRows");
  timeTbody.innerHTML = "";
  student.timetable.forEach(slot => {
    timeTbody.innerHTML += `<tr><td><b>${slot.time}</b></td><td>${slot.subject}</td><td>${slot.room}</td><td>${slot.type}</td></tr>`;
  });
}

function searchStudent() {
  const query = document.getElementById("searchRollInput").value.trim();
  loadStudentByRoll(query);
}

function runGpaSim() {
  const ext = parseInt(document.getElementById("simExtInput").value);
  document.getElementById("simExtLbl").textContent = `${ext} / 70`;
  document.getElementById("simGpaVal").textContent = ((ext * 0.08) + 2.4).toFixed(2);
}

function sendChatMessage() {
  const input = document.getElementById("chatUserQuery");
  const text = input.value.trim();
  if (!text) return;
  appendChat("user", text);
  input.value = "";
  setTimeout(() => {
    appendChat("bot", `<b>Nexora AI Response:</b> Analyzing your query regarding "${text}" in the context of your CSE curriculum.`);
  }, 400);
}

function askQuickPrompt(pText) {
  appendChat("user", pText);
  setTimeout(() => {
    appendChat("bot", `<b>Nexora AI Response:</b> ${pText.includes('B-Trees') ? 'B-Trees store pointers everywhere; B+ Trees store data only in leaf nodes with linked lists for fast range queries.' : 'The 4 conditions are Mutual Exclusion, Hold & Wait, No Preemption, and Circular Wait.'}`);
  }, 400);
}

function appendChat(role, html) {
  const list = document.getElementById("chatMsgList");
  const msg = document.createElement("div");
  msg.className = `chat-msg ${role}`;
  msg.innerHTML = `<div class="logo-icon" style="width:30px; height:30px; font-size:14px;">${role === 'bot' ? '✦' : '👤'}</div><div class="chat-bubble">${html}</div>`;
  list.appendChild(msg);
  list.scrollTop = list.scrollHeight;
}

window.addEventListener("DOMContentLoaded", () => {
  loadStudentByRoll("107");
});
</script>
</body>
</html>

    <div class="ai-hero-card" style="margin-top: 18px;">
      <div class="ai-dial-box">
        <svg class="ai-dial-svg" viewBox="0 0 120 120">
          <defs>
            <linearGradient id="scoreGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#55e6c1"/>
